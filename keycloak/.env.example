# =============================================================================
# CDPI PoC — Keycloak Standalone environment
# Generado automáticamente por init-keycloak.sh
# También puedes copiar este archivo a .env y editar manualmente.
# =============================================================================

# URL pública de Keycloak (http o https según configuración)
KC_PUBLIC_URL=http://localhost:8080

# Dominio (si aplica) y modo SSL
DOMAIN=
USE_SSL=false

# Credenciales de admin Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret compartido para los clientes CREDEBL (credebl-client, adminClient)
# Se usa en setup-credebl-realm.sh
KEYCLOAK_CLIENT_SECRET=change-me

# PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me

# Puertos
KEYCLOAK_PORT=8080
POSTGRES_PORT=5434
